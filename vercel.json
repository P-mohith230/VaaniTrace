{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "static/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "PYTHONPATH": "."
  }
}
