# VaaniTrace Environment Configuration Example
# Copy this file to .env and provide your actual credentials.

# Application Mode & Server
APP_ENV=production
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Persistence & Storage
DATABASE_URL=sqlite:///./data/vaanitrace.db
DATA_DIR=./data
STATIC_DIR=./static/dist

# Gnani AI Configuration
# Get your API key from https://app.gnani.ai/voice
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5

# Security & CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
